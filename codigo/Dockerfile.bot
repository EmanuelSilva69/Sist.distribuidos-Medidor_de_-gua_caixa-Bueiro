# ESTÁGIO 1: Compilação (Builder)
# Usamos uma imagem Debian completa para ter acesso às ferramentas de build
FROM debian:bookworm-slim AS builder

# Atualiza os repositórios e instala o compilador GCC e as bibliotecas de DESENVOLVIMENTO (-dev)
# Essas bibliotecas contêm os headers (.h) necessários para compilar o código
RUN apt-get update && apt-get install -y \
    gcc \
    libcurl4-openssl-dev \
    libcjson-dev \
    libqrencode-dev \
    make \
    && rm -rf /var/lib/apt/lists/*

# Define a pasta de trabalho onde os códigos serão processados
WORKDIR /app

# Copia os arquivos-fonte C para dentro do estágio de build
COPY conectarevolution.c codigodeenvioc.c ./

# Compila o utilitário de Setup (QR Code) 
# A flag -I/usr/include/cjson resolve o erro de localização do header cJSON.h
RUN gcc conectarevolution.c -o setup_qr -lcurl -lcjson -lqrencode -I/usr/include/cjson

# Compila o Bot de Monitoramento principal que consultará o middleware 
RUN gcc codigodeenvioc.c -o bot_monitor -lcurl -lcjson -I/usr/include/cjson

# ESTÁGIO 2: Execução (Final)
# Começamos uma imagem nova, sem o "lixo" da compilação anterior
FROM debian:bookworm-slim

# Instala apenas as bibliotecas de EXECUÇÃO (runtime), mantendo a imagem leve e segura
RUN apt-get update && apt-get install -y \
    libcurl4 \
    libcjson1 \
    libqrencode4 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# "Rouba" apenas os binários compilados do estágio builder para a imagem final
COPY --from=builder /app/setup_qr .
COPY --from=builder /app/bot_monitor .

# Define o comando que inicia automaticamente ao subir o container
# O bot começará a monitorar o nível do reservatório imediatamente 
CMD ["./bot_monitor"]