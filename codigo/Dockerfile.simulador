# Estágio único para compilar e executar o simulador ESP32 em C
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    gcc \
    libcurl4-openssl-dev \
    libcjson-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY simulador_esp32_interSCity.c ./

RUN gcc -std=c11 -Wall -Wextra -pedantic simulador_esp32_interSCity.c -o simulador_esp32_interSCity -lcurl -lcjson -lm -I/usr/include/cjson

CMD ["./simulador_esp32_interSCity"]
